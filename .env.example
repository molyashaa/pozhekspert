# Скопируйте этот файл в .env и заполните. Файл .env не публикуется (он в .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# для хостинга, например: https://pozhexpert.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 — если сайт работает по https (на хостинге)
DJANGO_HTTPS=0

# --- База данных ---
# mysql  — MySQL/MariaDB (XAMPP или хостинг) — основной вариант по ТЗ
# sqlite — файл db.sqlite3, если MySQL под рукой нет (запасной вариант для показа)
DB_ENGINE=mysql
DB_NAME=pozh_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Прототип ---
DEMO_MODE=1
# Кнопки быстрого входа под каждой ролью на странице входа (удобно на защите)
DEMO_QUICK_LOGIN=1
# Порог релевантности ИИ-помощника (0.15 = 15 %)
AI_THRESHOLD=0.15
FILE_UPLOAD_MAX_MB=25
